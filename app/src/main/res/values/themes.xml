    <style name="ThemeOverlay.NextGen.Accent.Teal">
        <item name="colorPrimary">@color/accent_teal_light_primary</item>
        <item name="colorOnPrimary">@color/accent_teal_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/accent_teal_light_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_teal_light_onContainer</item>
    </style>

    <style name="ThemeOverlay.NextGen.Accent.Orange">
        <item name="colorPrimary">@color/accent_orange_light_primary</item>
        <item name="colorOnPrimary">@color/accent_orange_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/accent_orange_light_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_orange_light_onContainer</item>
    </style>

    <style name="ThemeOverlay.NextGen.Accent.Red">
        <item name="colorPrimary">@color/accent_red_light_primary</item>
        <item name="colorOnPrimary">@color/accent_red_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/accent_red_light_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_red_light_onContainer</item>
    </style>

    <style name="ThemeOverlay.NextGen.Accent.Pink">
        <item name="colorPrimary">@color/accent_pink_light_primary</item>
        <item name="colorOnPrimary">@color/accent_pink_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/accent_pink_light_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_pink_light_onContainer</item>
    </style>
</resources>
