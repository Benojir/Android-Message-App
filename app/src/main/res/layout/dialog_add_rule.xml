<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Rule Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_rule_name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dialog_rule_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_rule_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Condition Type Dropdown / Radio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:text="@string/dialog_rule_type_hint"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorPrimary" />

        <RadioGroup
            android:id="@+id/rg_rule_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_body_contains"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rule_type_body_contains" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_sender_equals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rule_type_sender_equals" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_sender_contains"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rule_type_sender_contains" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_body_starts_with"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rule_type_body_starts_with" />
        </RadioGroup>

        <!-- Pattern / Keyword Value -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_rule_value"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/dialog_rule_value_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_rule_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Target Category Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_rule_category_hint"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorPrimary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_rule_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_target_personal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:tag="personal"
                    android:text="@string/category_personal_title" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_target_transactions"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="transactions"
                    android:text="@string/category_transactions_title" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_target_otp"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="otp"
                    android:text="@string/category_otp_title" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_target_promotions"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="promotions"
                    android:text="@string/category_promotions_title" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_target_business"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="business"
                    android:text="@string/category_business_title" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_target_spam"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="spam"
                    android:text="@string/category_spam_title" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_target_other"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="other"
                    android:text="@string/category_other_title" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

    </LinearLayout>
</ScrollView>
