<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        app:layout_constraintBottom_toTopOf="@+id/dots_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:contentDescription="@null"
            android:padding="16dp"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:id="@+id/tv_auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnBackground"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_auth_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_lock_enter_pin"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tv_lockout_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="Too many failed attempts. Try again in 30 seconds."
            tools:visibility="visible" />

    </LinearLayout>

    <!-- 6 Pin Indicator Dots -->
    <LinearLayout
        android:id="@+id/dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/keypad_grid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container">

        <ImageView
            android:id="@+id/dot_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_5"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin_dot_empty" />

        <ImageView
            android:id="@+id/dot_6"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin_dot_empty" />

    </LinearLayout>

    <!-- Keypad Grid -->
    <GridLayout
        android:id="@+id/keypad_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:columnCount="3"
        android:rowCount="4"
        app:layout_constraintBottom_toTopOf="@+id/btn_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_1"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_1_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="1"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_2"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_2_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="2"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_3"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_3_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="3"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <!-- Row 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_4"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_4_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="4"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_5"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_5_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="5"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_6"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_6_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="6"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <!-- Row 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_7"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_7_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="7"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_8"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_8_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="8"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_9"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_9_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="9"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <!-- Row 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_biometric"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/btn_biometric_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_fingerprint"
            app:iconGravity="textStart"
            app:iconSize="32dp"
            app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_0"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/key_0_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="0"
            android:textSize="24sp"
            app:cornerRadius="36dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_backspace"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/btn_backspace_desc"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_backspace"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/btn_exit_app"
        android:textColor="?attr/colorOutline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
