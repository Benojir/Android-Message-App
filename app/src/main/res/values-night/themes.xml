        <item name="android:statusBarColor">@color/amoled_background</item>
        <item name="android:navigationBarColor">@color/amoled_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Base Accent Theme Overlay -->
